diff --git a/gcc/lower-subreg.cc b/gcc/lower-subreg.cc
index 6d8d6f910..d3d287791 100644
--- a/gcc/lower-subreg.cc
+++ b/gcc/lower-subreg.cc
@@ -761,9 +761,28 @@ simplify_gen_subreg_concatn (machine_mode outermode, rtx op,
 				     SUBREG_BYTE (op));
       if (op2 == NULL_RTX)
 	{
-	  /* We don't handle paradoxical subregs here.  */
 	  gcc_assert (!paradoxical_subreg_p (outermode, GET_MODE (op)));
-	  gcc_assert (!paradoxical_subreg_p (op));
+	  if (paradoxical_subreg_p (op))
+	    {
+	      /* A paradoxical SUBREG of a decomposed register, e.g.
+		 (subreg:SI (reg:HI) 0) with the HImode register split into
+		 QImode parts.  As for a plain register below, the parts
+		 outside the inner register have no value.  */
+	      machine_mode inner = GET_MODE (SUBREG_REG (op));
+	      poly_int64 offset = byte;
+	      if (BYTES_BIG_ENDIAN)
+		offset -= (GET_MODE_SIZE (GET_MODE (op))
+			   - GET_MODE_SIZE (inner));
+	      if (maybe_lt (offset, 0)
+		  || maybe_ge (offset, GET_MODE_SIZE (inner)))
+		return CONST0_RTX (outermode);
+	      gcc_assert (known_le (offset + GET_MODE_SIZE (outermode),
+				    GET_MODE_SIZE (inner)));
+	      op2 = simplify_subreg_concatn (outermode, SUBREG_REG (op),
+					     offset);
+	      gcc_assert (op2 != NULL_RTX);
+	      return op2;
+	    }
 	  op2 = simplify_subreg_concatn (outermode, SUBREG_REG (op),
 					 byte + SUBREG_BYTE (op));
 	  gcc_assert (op2 != NULL_RTX);
